{
  "info": {
    "name": "API de Produtos — Atividade de Back-end",
    "description": "Coleção acadêmica para a API Laravel com persistência em storage/app/produtos.json. Execute a coleção inteira em ordem, com 1 iteração. O POST inicial cadastra um produto de demonstração e salva seu ID; o DELETE exclui somente esse produto. Os demais cadastros permanecem no arquivo. Requisições dependentes são puladas se não houver ID válido. Se interromper a execução antes do DELETE, exclua manualmente o produto criado usando o ID salvo. A última requisição depende do acesso à internet para consultar JSONPlaceholder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "produto_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "produto_excluido",
      "value": "false",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — CRUD e validações (executar em ordem)",
      "item": [
        {
          "name": "01 — Cadastrar produto e salvar seu ID (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/produtos",
            "description": "Cria o produto solicitado na atividade e salva data.id em produto_id. Execute antes das operações dependentes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Notebook Acer Nitro V15\",\n  \"preco\": 4500,\n  \"estoque\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"produto_id\", \"\");",
                  "pm.collectionVariables.set(\"produto_excluido\", \"false\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Resposta com Content-Type application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"Corpo é um JSON válido\", function () {",
                  "    pm.expect(function () { pm.response.json(); }).not.to.throw();",
                  "});",
                  "pm.test(\"Resource contém os campos e tipos do produto\", function () {",
                  "    const produto = pm.response.json().data;",
                  "    pm.expect(produto).to.have.all.keys(\"id\", \"nome\", \"preco\", \"estoque\");",
                  "    pm.expect(produto.id).to.be.a(\"number\");",
                  "    pm.expect(Number.isInteger(produto.id)).to.eql(true);",
                  "    pm.expect(produto.id).to.be.above(0);",
                  "    pm.expect(produto.nome).to.be.a(\"string\");",
                  "    pm.expect(produto.preco).to.be.a(\"number\");",
                  "    pm.expect(produto.estoque).to.be.a(\"number\");",
                  "    pm.expect(Number.isInteger(produto.estoque)).to.eql(true);",
                  "});",
                  "pm.test(\"Cadastro retorna os dados enviados e salva o ID\", function () {",
                  "    const produto = pm.response.json().data;",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "    pm.expect(Number.isInteger(produto.id) && produto.id > 0).to.eql(true);",
                  "    pm.expect(produto.nome).to.eql(\"Notebook Acer Nitro V15\");",
                  "    pm.expect(produto.preco).to.eql(4500);",
                  "    pm.expect(produto.estoque).to.eql(5);",
                  "    pm.collectionVariables.set(\"produto_id\", String(produto.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Listar produtos e localizar o cadastro (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/produtos",
            "description": "Confere o envelope data e que o produto criado está na listagem."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const produtoId = String(pm.collectionVariables.get(\"produto_id\") || \"\");",
                  "if (!/^[1-9][0-9]*$/.test(produtoId)) {",
                  "    console.warn(\"Execute primeiro a requisição 01 — Cadastrar produto. Nenhum ID válido foi salvo.\");",
                  "    pm.execution.skipRequest();",
                  "}",
                  "pm.variables.set(\"produto_id\", produtoId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Resposta com Content-Type application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"Corpo é um JSON válido\", function () {",
                  "    pm.expect(function () { pm.response.json(); }).not.to.throw();",
                  "});",
                  "pm.test(\"Lista contém o produto recém-cadastrado\", function () {",
                  "    const produtos = pm.response.json().data;",
                  "    pm.expect(produtos).to.be.an(\"array\");",
                  "    const produto = produtos.find(function (item) { return item.id === Number(pm.collectionVariables.get(\"produto_id\")); });",
                  "    pm.expect(produto).to.deep.eql({ id: Number(pm.collectionVariables.get(\"produto_id\")), nome: \"Notebook Acer Nitro V15\", preco: 4500, estoque: 5 });",
                  "});"
                ]
              }
            }
          ]
        },
